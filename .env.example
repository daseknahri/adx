NODE_ENV=production
PORT=8080
APP_URL=https://reports.example.com
DB_PATH=/data/app.db
SESSION_SECRET=replace-with-a-long-random-secret
TOKEN_ENCRYPTION_KEY=replace-with-64-hex-chars

# Required production administrator. These credentials are applied on each deploy,
# including to an existing database. Do not use the old SEED_* values in production.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Google OAuth / Google Ad Manager AdX reporting.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://reports.example.com/api/admin/google/oauth/callback
AD_MANAGER_NETWORK_CODE=23350042371
AD_MANAGER_REPORT_ID=7704780540
AD_MANAGER_REPORT_DIMENSIONS=SITE
AD_MANAGER_REPORT_METRICS=REVENUE,AD_EXCHANGE_CTR,AD_EXCHANGE_AVERAGE_ECPM,TOTAL_IMPRESSIONS
REPORT_CURRENCY=MAD
ADX_BACKFILL_DAYS=90

# Optional enrichment. Only needed if you want Analytics visitor fields too.
GA4_PROPERTY_ID=

# Optional. OAuth connection also enables live sync automatically.
ENABLE_GOOGLE_SYNC=true

# Optional. Enables token-protected scheduled refreshes:
# POST /api/cron/sync/google/latest with Authorization: Bearer <CRON_SECRET>
CRON_SECRET=replace-with-a-long-random-secret
