{
  "name": "adsense-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Client/admin dashboard for rented subdomain AdX tracking",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --host 0.0.0.0",
    "build": "vite build --outDir server/public",
    "start": "node server/index.js",
    "test": "node --test",
    "check": "node --check server/index.js && node --check server/tasks/cron-refresh.mjs && node --check scripts/dev.mjs && node --check scripts/smoke.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.1",
    "cookie-parser": "^1.4.7",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.0"
  },
  "devDependencies": {}
}
